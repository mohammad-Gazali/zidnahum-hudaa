# Docker Compose environment — copy to `.env` and fill in real values:
#   cp .env.example .env

# Required — use a long random string (e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`)
SECRET_KEY=django-insecure--change-me-to-a-long-random-string

# false in production
DEBUG=false

# Public host the app is served under (nginx is on port 80).
# Use "localhost" for a local-only deployment.
ALLOWED_HOST=localhost

# Default coming category used by the app (coming records without a category).
Q_COMING_CATEGORY_ID=1
