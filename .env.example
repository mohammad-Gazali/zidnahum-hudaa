# Docker Compose environment — copy to `.env` and fill in real values:
#   cp .env.example .env

# Required — use a long random string (e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`)
SECRET_KEY=django-insecure--change-me-to-a-long-random-string

# false in production
DEBUG=false

# Public host the app is served under. nginx terminates HTTPS on 443 for this
# domain (Let's Encrypt certificate managed fully inside docker) and redirects
# HTTP to HTTPS.
DOMAIN=wazidnahm.com
ALLOWED_HOST=wazidnahm.com

# Email certbot registers with Let's Encrypt (required for issuance/renewal).
# Point the domain above at this host's public IP and open ports 80 + 443 first.
LETSENCRYPT_EMAIL=you@example.com

# Default coming category used by the app (coming records without a category).
Q_COMING_CATEGORY_ID=1