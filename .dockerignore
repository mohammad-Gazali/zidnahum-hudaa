# Mirrors .gitignore, plus Docker-build-specific entries.
# Keeps the build context small and makes sure nothing generated locally
# (which may be stale or environment-specific) leaks into the image instead
# of the fresh copy the Dockerfile itself produces.

.git
.gitignore

# Python
**/__pycache__
*.pyc
.venv
venv

# Generated by `manage.py build` / collectstatic — the Dockerfile regenerates
# these itself; copying stale local ones in would defeat that.
backend/static
backend/templates
staticfiles
media
db.sqlite3
database

# Frontend
frontend/node_modules
frontend/dist
frontend/.angular

# Editors / misc
.vscode
.zed
.idea
*.xlsx
TODO.txt

# Docker/compose itself
.env
docker-compose*.yml
Dockerfile
